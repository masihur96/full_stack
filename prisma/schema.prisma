// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------
// YOUR CHOOLCARE DATABASE MODELS
// --------------------------------------------------

// The User model will handle both Students and Teachers
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(STUDENT)
  
  // Relations: A teacher can create many exams, a student can take many exams
  examsCreated Exam[]   @relation("TeacherExams")
  examsTaken   Exam[]   @relation("StudentExams")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The Exam model for the exam management feature
model Exam {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  
  // Relation to the Teacher who created it
  teacherId   Int
  teacher     User     @relation("TeacherExams", fields: [teacherId], references: [id])

  // Relation to the Students taking it
  students    User[]   @relation("StudentExams")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// An Enum to strictly define user roles
enum Role {
  STUDENT
  TEACHER
  ADMIN
}